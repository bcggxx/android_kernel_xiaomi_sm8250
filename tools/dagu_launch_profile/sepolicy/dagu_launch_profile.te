# Merge into PLATFORM PRIVATE policy, not vendor policy (system_server boundary).
type dagu_launch_profile, domain;
type dagu_launch_profile_exec, exec_type, file_type, system_file_type;
init_daemon_domain(dagu_launch_profile)
type dagu_launch_profile_socket, file_type;
type dagu_launch_profile_device, dev_type;
system_internal_prop(dagu_launch_profile_enabled_prop)
set_prop(system_server, dagu_launch_profile_enabled_prop)
userdebug_or_eng(`set_prop(shell, dagu_launch_profile_enabled_prop)')
get_prop(init, dagu_launch_profile_enabled_prop)
allow dagu_launch_profile self:capability sys_admin;
allow dagu_launch_profile self:unix_stream_socket create_stream_socket_perms;
allow dagu_launch_profile dagu_launch_profile_device:chr_file { open read write ioctl getattr };
allow dagu_launch_profile system_server:fd use;
unix_socket_connect(system_server, dagu_launch_profile, dagu_launch_profile)
# SCM_RIGHTS file_receive checks the duplicated O_RDWR Binder driver file.
# Kernel consumes its private identity; helper never invokes Binder ioctls.
allow dagu_launch_profile binder_device:chr_file { read write };
neverallow { domain -system_server -init } dagu_launch_profile_socket:sock_file write;
neverallow { domain -system_server -dagu_launch_profile } dagu_launch_profile:unix_stream_socket connectto;

# Exported immutable snapshot and original file descriptions are metadata-only
# in ticket07. No app data content reads or persistence are enabled here.
allow dagu_launch_profile appdomain:fd use;
allow dagu_launch_profile { apk_data_file dalvikcache_data_file system_file vendor_file }:file getattr;
# Snapshot anonymous file metadata/read path is owned by this helper domain.
allow dagu_launch_profile self:file { read getattr };
