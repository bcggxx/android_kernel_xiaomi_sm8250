# Platform integration, disabled until explicit trusted property opt-in.
service launch_profile /system/bin/launch_profile_helper
    class late_start
    user root
    group root
    capabilities SYS_ADMIN
    disabled
    # Endpoint SID defaults to service domain; file_contexts labels the pathname.
    socket launch_profile seqpacket 0600 system system

on post-fs-data
    mkdir /data/misc/launch_profile 0700 root root
    copy /proc/sys/kernel/random/boot_id /data/misc/launch_profile/boot_id
    restorecon_recursive /data/misc/launch_profile

on property:sys.launch_profile.enabled=1
    start launch_profile
