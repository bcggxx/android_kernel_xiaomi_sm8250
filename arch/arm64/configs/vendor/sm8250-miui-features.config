# SPDX-License-Identifier: GPL-2.0
# MIUI/HyperOS features shared by every supported device; MIUI builds only.
# Existing runtime controls retain their defaults; see sm8250-features.rst.
CONFIG_MIHW=y
CONFIG_BINDER_PRIO=y
CONFIG_KSHRINK_SLABD=y
CONFIG_MI_RMAP_EFFICIENCY=y
CONFIG_MI_MTMR=y
CONFIG_MI_ASYNC_RECLAIM=y
CONFIG_MOON_MMAP_OPT=y
CONFIG_MI_MEMPOOL=y
CONFIG_MI_FAULT_AROUND=y
CONFIG_MI_RECLAIM_POOL=y
CONFIG_MI_MEM_ENGINE=y
CONFIG_LAUNCH_PROFILE=y
CONFIG_MI_SW_SYNC=y
CONFIG_SYNC_FILE=y
CONFIG_MI_UNION_POWER=y
# CONFIG_READAHEAD_LIMIT is not set
# CONFIG_FAULT_INJECTION is not set
